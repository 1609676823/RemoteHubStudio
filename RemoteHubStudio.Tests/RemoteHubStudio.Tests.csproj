<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RemoteHubStudio.Tests</AssemblyName>
    <RootNamespace>RemoteHubStudio.Tests</RootNamespace>
    <Product>RemoteHubStudio Tests</Product>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RemoteHubStudio\RemoteHubStudio.csproj" />
  </ItemGroup>

  <!-- Replay source designer layouts with the compiler already shipped in the build SDK. -->
  <Target Name="AddDesignerCompilerReferences" BeforeTargets="ResolveAssemblyReferences">
    <PropertyGroup>
      <DesignerCompilerPath Condition="Exists('$(RoslynTargetsPath)\bincore\Microsoft.CodeAnalysis.dll')">$(RoslynTargetsPath)\bincore</DesignerCompilerPath>
      <DesignerCompilerPath Condition="Exists('$(RoslynTargetsPath)\..\bincore\Microsoft.CodeAnalysis.dll')">$(RoslynTargetsPath)\..\bincore</DesignerCompilerPath>
    </PropertyGroup>
    <ItemGroup>
      <Reference Include="Microsoft.CodeAnalysis" HintPath="$(DesignerCompilerPath)\Microsoft.CodeAnalysis.dll" />
      <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(DesignerCompilerPath)\Microsoft.CodeAnalysis.CSharp.dll" />
    </ItemGroup>
  </Target>
  <!-- Do not attach the app's .Designer.cs files to a second VS project/editor. -->
  <Target Name="EmbedDesignerSources" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <DesignerSource Include="..\RemoteHubStudio\UI\**\*.Designer.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(DesignerSource)" DestinationFiles="@(DesignerSource->'$(IntermediateOutputPath)DesignerSources\%(Filename)%(Extension).txt')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <EmbeddedResource Include="@(DesignerSource->'$(IntermediateOutputPath)DesignerSources\%(Filename)%(Extension).txt')">
        <LogicalName>DesignerSources.%(Filename)%(Extension)</LogicalName>
        <WithCulture>false</WithCulture>
      </EmbeddedResource>
    </ItemGroup>
  </Target>

</Project>
