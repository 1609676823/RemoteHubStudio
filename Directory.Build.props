<Project>
  <!-- Product metadata is centralized here for packaging and assembly generation. / 产品元数据集中在此处，供打包与程序集生成使用。 -->
  <PropertyGroup>
    <Product>RemoteHubStudio</Product>
    <!-- Maintain only Version; the SDK derives AssemblyVersion, FileVersion and InformationalVersion. / 仅维护 Version，其余版本由 SDK 派生。 -->
    <Version>0.1.0</Version>
    <Authors>RemoteHubStudio Contributors</Authors>
    <Company>$(Authors)</Company>
    <Description>A responsive Windows remote connection manager built with AntdUI.</Description>
    <Copyright>Copyright © 2026 $(Authors)</Copyright>
    <RepositoryUrl>https://github.com/1609676823/RemoteHubStudio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <PackageReleaseNotes>$(RepositoryUrl)/releases</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IssuesUrl>$(RepositoryUrl)/issues</IssuesUrl>
    <LicenseUrl>$(RepositoryUrl)/blob/master/LICENSE.txt</LicenseUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Standard attributes, including RepositoryUrl, are generated by the SDK. / 标准特性（含 RepositoryUrl）由 SDK 自动生成。 -->
    <AssemblyMetadata Include="Authors" Value="$(Authors)" />
    <AssemblyMetadata Include="ProjectUrl" Value="$(PackageProjectUrl)" />
    <AssemblyMetadata Include="IssuesUrl" Value="$(IssuesUrl)" />
    <AssemblyMetadata Include="ReleasesUrl" Value="$(PackageReleaseNotes)" />
    <AssemblyMetadata Include="LicenseUrl" Value="$(LicenseUrl)" />
    <AssemblyMetadata Include="License" Value="$(PackageLicenseExpression)" />
  </ItemGroup>
</Project>
